{
  "name": "Waymarking Tweaks",
  "version": "0.0",
  "description": "Tweak Waymarking.com",
  "manifest_version": 2,
  "browser_action": {
    "default_title": "Open Extension"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions":[
    "webRequest",
    "webRequestBlocking",
    "*://*.waymarking.com/*"
  ]
}
